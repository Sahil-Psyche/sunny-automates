    {
      "id": "e5a2dd3b-d87b-47ef-9a43-b72e56cc5761",
      "name": "AI Score Lead",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        672,
        0
      ],
      "parameters": {
        "resource": "text",
        "operation": "response",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "responses": {
          "values": [
            {
              "type": "text",
              "role": "system",
              "content": "You are a lead qualification assistant for an Indian small business. Score the lead as HOT, WARM, or COLD based on the message intent and source. Return JSON only: {\"score\":\"HOT|WARM|COLD\",\"reason\":\"short reason\",\"replyDraft\":\"a short friendly reply to the lead in English\"}."
            },
            {
              "type": "text",
              "role": "user",
              "content": "={{ \"Name: \" + $json.leadName + \"\\nPhone: \" + $json.leadPhone + \"\\nSource: \" + $json.leadSource + \"\\nMessage: \" + $json.leadMessage }}"
            }
          ]
        },
        "simplify": true,
        "options": {
          "temperature": 0.3
        }
      }
    },
    {
      "id": "2e257a38-3c94-46c5-9315-56fbd3b0cb33",
      "name": "Is Hot Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        1024,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.output }}",
              "operator": {
                "type": "string",
                "operation": "contains"
              },
              "rightValue": "HOT"
            }
          ],
          "combinator": "and"
        }
      }
    },
