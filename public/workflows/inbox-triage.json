    { "id": "clean", "kind": "action", "label": "Strip the noise", "sub": "quotes · signatures" },
    { "id": "classify", "kind": "ai", "label": "Classify + summarise", "sub": "urgent / client / admin / noise + confidence" },
    { "id": "route", "kind": "logic", "label": "Route by class", "sub": "confidence threshold 0.7" },
    { "id": "telegram", "kind": "output", "label": "Urgent alert", "sub": "Telegram + summary + link" },
    { "id": "draft", "kind": "output", "label": "Draft reply", "sub": "waits for approval (never auto-sent)" },
    { "id": "log", "kind": "output", "label": "Sheets log", "sub": "every message" },
    { "id": "review", "kind": "human", "label": "Human review", "sub": "low confidence (< 0.7)" },
    { "id": "error", "kind": "output", "label": "Error alert", "sub": "node · error · run link (Telegram)" }
