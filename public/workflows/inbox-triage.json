  "nodes": [
    {
      "id": "9cc403f9-5995-480c-8daa-d3d0a8c83e14",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        176
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "filters": {
          "q": "is:unread",
          "readStatus": "unread"
        },
        "simple": true
      }
    },
    {
      "id": "f9263632-9a94-4af1-8c66-c07a42a2cb1c",
      "name": "Normalize Email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
        176
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "fromAddr",
              "value": "={{ $json.From }}",
              "type": "string"
            },
            {
              "id": "b2",
              "name": "subject",
              "value": "={{ $json.Subject }}",
              "type": "string"
            },
            {
              "id": "b3",
              "name": "snippet",
              "value": "={{ $json.snippet }}",
              "type": "string"
            },
            {
              "id": "b4",
              "name": "receivedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "862b6d5b-2b5e-4775-8748-93b780db4fc3",
      "name": "AI Triage & Draft",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        448,
        176
      ],
      "parameters": {
        "resource": "text",
        "operation": "response",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "responses": {
          "values": [
            {
              "type": "text",
              "role": "system",
              "content": "You are an email triage assistant. Classify the email as URGENT, ROUTINE, or SPAM. For ROUTINE, draft a polite reply. Return JSON only: {\"category\":\"URGENT|ROUTINE|SPAM\",\"reason\":\"short\",\"draft\":\"reply text or empty\"}."
            },
            {
              "type": "text",
              "role": "user",
              "content": "={{ \"From: \" + $json.fromAddr + \"\\nSubject: \" + $json.subject + \"\\nBody: \" + $json.snippet }}"
            }
          ]
        },
        "simplify": true,
        "options": {
          "temperature": 0.3
        }
      }
    },
    {
      "id": "429e6aec-1acc-4b5c-be40-aec2d1171dcb",
      "name": "Is Urgent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        800,
        176
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.output }}",
              "operator": {
                "type": "string",
                "operation": "contains"
              },
              "rightValue": "URGENT"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "97c848be-42ca-4952-8cb7-5b9d1bea2b07",
      "name": "Alert Owner (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1248,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "OWNER_CHAT_ID",
        "text": "={{ \"Urgent email from \" + $json.fromAddr + \"\\nSubject: \" + $json.subject + \"\\nAI: \" + $json.output }}"
      },
      "webhookId": "31c14e82-4855-49f0-b4f5-4596b9748325"
    },
