---
import type { Project } from '../data/projects';
import MiniFlow from './MiniFlow.astro';

interface Props {
  project: Project;
  order: number;
}

const { project, order } = Astro.props;
---

<a
  class="work-row reveal"
  href={`/work/${project.slug}`}
  style={`--d:${order}`}
  aria-label={`${project.title} — view case study`}
>
  <span class="work-index">{project.index}</span>

  <span class="work-main">
    <span class="work-kicker">
      <span>{project.sector}</span>
      <span class="work-sep">/</span>
      <span class="work-type">{project.buildType}</span>
    </span>
    <span class="work-title">{project.title}</span>
    <span class="work-dek">{project.dek}</span>
    <span class="work-tags">
      {project.stack.slice(0, 4).map((tool) => (
        <span>{tool}</span>
      ))}
    </span>
  </span>

  <span class="work-visual" aria-hidden="true">
    <span class="work-fig">case {project.index} — {project.navTitle.toLowerCase()}</span>
    <MiniFlow nodes={project.flow.nodes} edges={project.flow.edges} />
  </span>

  <span class="work-arrow" aria-hidden="true">↗</span>
</a>

<style>
  .work-row {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr) 250px 46px;
    align-items: center;
    gap: clamp(20px, 3vw, 42px);
    padding: 34px 20px;
    margin-inline: -20px;
    border-top: 1px solid var(--line);
    color: var(--ink);
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease);
  }

  .work-row:hover {
    background: var(--ink);
    color: var(--paper-on-ink);
  }

  .work-index {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    align-self: start;
    padding-top: 5px;
    transition: color 0.4s var(--ease);
  }

  .work-row:hover .work-index {
    color: var(--signal);
  }

  .work-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .work-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 16px;
    transition: color 0.4s var(--ease);
  }

  .work-row:hover .work-kicker {
    color: rgba(239, 233, 220, 0.74);
  }

  .work-sep {
    color: var(--line-strong);
  }

  .work-type {
    color: var(--signal-ink);
  }

  .work-row:hover .work-type {
    color: var(--signal);
  }

  .work-title {
    font-size: clamp(1.65rem, 3.3vw, 2.65rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.045em;
    margin-bottom: 12px;
    text-wrap: balance;
  }

  .work-dek {
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 54ch;
    margin-bottom: 20px;
    transition: color 0.4s var(--ease);
  }

  .work-row:hover .work-dek {
    color: rgba(239, 233, 220, 0.8);
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-3);
    transition: color 0.4s var(--ease);
  }

  .work-tags span {
    position: relative;
  }

  .work-tags span:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -9px;
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
    transform: translateY(-50%);
  }

  .work-row:hover .work-tags {
    color: rgba(239, 233, 220, 0.68);
  }

  .work-visual {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 14px 10px;
    border: 1px solid var(--line);
    transition: border-color 0.4s var(--ease);
  }

  .work-row:hover .work-visual {
    border-color: rgba(239, 233, 220, 0.22);
  }

  .work-fig {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    transition: color 0.4s var(--ease);
  }

  .work-row:hover .work-fig {
    color: rgba(239, 233, 220, 0.62);
  }

  .work-arrow {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    font-size: 18px;
    justify-self: end;
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease),
      color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .work-row:hover .work-arrow {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--ink);
    transform: translate(3px, -3px);
  }

  @media (max-width: 1100px) {
    .work-row {
      grid-template-columns: 44px minmax(0, 1fr) 190px 42px;
      gap: 24px;
    }
  }

  @media (max-width: 820px) {
    .work-row {
      grid-template-columns: 34px minmax(0, 1fr) 40px;
      gap: 16px;
      padding-block: 28px;
    }

    .work-visual {
      display: none;
    }

    .work-arrow {
      width: 38px;
      height: 38px;
      font-size: 16px;
    }
  }

  @media (max-width: 480px) {
    .work-row {
      margin-inline: -10px;
      padding-inline: 10px;
    }

    .work-dek {
      font-size: 14.5px;
    }

    .work-tags {
      font-size: 10.5px;
    }
  }
</style>
