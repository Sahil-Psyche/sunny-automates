---
import { gmailLink, navLinks, site } from '../data/site';
---

<footer class="site-footer">
  <div class="wrap footer-top">
    <div class="footer-brand">
      <div class="footer-brand-row">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 28 28" fill="none">
            <path d="M5.5 21 13 8.5 22.5 17" stroke="currentColor" stroke-width="1.3" />
            <circle cx="5.5" cy="21" r="2.5" stroke="currentColor" stroke-width="1.3" />
            <circle cx="13" cy="8.5" r="2.5" stroke="currentColor" stroke-width="1.3" />
            <circle cx="22.5" cy="17" r="2.7" fill="var(--signal)" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </span>
        <p class="footer-name">Sunny Automates</p>
      </div>
      <p class="footer-line">
        Process-first automation for small teams.<br />
        Built by Sahil, from India.
      </p>
      <a class="btn btn--small footer-cta" href={gmailLink} target="_blank" rel="noopener">
        Start a build <span class="arrow">↗</span>
      </a>
    </div>

    <div class="footer-col">
      <p class="footer-label">Sitemap</p>
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <p class="footer-label">Elsewhere</p>
      <ul>
        <li><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
        <li><a href={site.github} target="_blank" rel="noopener">GitHub ↗</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>

    <div class="footer-col footer-col--status">
      <p class="footer-label">Local time</p>
      <p class="footer-clock">IST <time data-clock>--:--</time></p>
      <p class="footer-status">
        <span class="status-dot" aria-hidden="true"></span>
        Open for new builds
      </p>
      <a class="footer-top-link" href="#main">Back to top ↑</a>
    </div>
  </div>

  <div class="wrap footer-meta">
    <span>© {site.year} Sunny Automates</span>
    <span>Independent builder · India</span>
    <span>Process before tooling.</span>
  </div>

  <div class="footer-wordmark" aria-hidden="true">
    Sunny Automates<span class="footer-dot">.</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--paper-on-ink);
    overflow: hidden;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.6fr 0.8fr 1fr 1fr;
    gap: clamp(30px, 4vw, 64px);
    padding-block: 72px 48px;
  }

  .footer-brand-row {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 18px;
  }

  .brand-mark {
    width: 30px;
    height: 30px;
    color: var(--paper-on-ink);
    flex: none;
  }

  .footer-name {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .footer-line {
    color: rgba(239, 233, 220, 0.78);
    font-size: 14.5px;
    line-height: 1.55;
    max-width: 26ch;
  }

  .footer-cta {
    margin-top: 26px;
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }

  .footer-cta:hover {
    background: var(--signal);
    color: var(--ink);
    border-color: var(--signal);
  }

  .footer-label {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(239, 233, 220, 0.7);
    margin-bottom: 18px;
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col a {
    font-size: 14px;
    color: rgba(239, 233, 220, 0.9);
    transition: color 0.2s var(--ease);
    overflow-wrap: anywhere;
  }

  .footer-col a:hover {
    color: var(--signal);
  }

  .footer-clock {
    font-family: var(--mono);
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--paper-on-ink);
    margin-bottom: 12px;
  }

  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(239, 233, 220, 0.78);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 3px rgba(255, 77, 28, 0.14);
    animation: blink 2.8s ease-in-out infinite;
  }

  .footer-top-link {
    display: block;
    width: fit-content;
    margin-top: 22px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(239, 233, 220, 0.7);
  }

  .footer-top-link:hover {
    color: var(--paper-on-ink);
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 20px;
    border-top: 1px solid rgba(239, 233, 220, 0.14);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgba(239, 233, 220, 0.7);
  }

  .footer-wordmark {
    padding: 26px var(--pad) 44px;
    font-size: clamp(2.2rem, 10.2vw, 13.5rem);
    font-weight: 600;
    line-height: 0.86;
    letter-spacing: -0.065em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(239, 233, 220, 0.58);
    user-select: none;
  }

  .footer-dot {
    color: var(--signal);
    -webkit-text-stroke: 0;
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      padding-block: 56px 40px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 540px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .footer-meta {
      justify-content: flex-start;
    }

    .footer-wordmark {
      padding-top: 26px;
    }
  }
</style>

<script>
  const clock = document.querySelector<HTMLElement>('[data-clock]');

  if (clock) {
    const format = new Intl.DateTimeFormat('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: 'Asia/Kolkata',
    });

    const tick = () => {
      clock.textContent = format.format(new Date());
    };

    tick();
    window.setInterval(tick, 30000);
  }
</script>
