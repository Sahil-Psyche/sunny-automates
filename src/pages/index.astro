---
import Base from '../layouts/Base.astro';
import HeroGraph from '../components/HeroGraph.astro';
import WorkRow from '../components/WorkRow.astro';
import { projects } from '../data/projects';
import { gmailLink, mailtoLink, site, stack } from '../data/site';

const process = [
  {
    index: '01',
    title: 'Find the break',
    body: 'Walk the process as it actually runs. Count the handoffs, the retyped data, the follow-up that lives in someone’s head. The map comes before the node.',
  },
  {
    index: '02',
    title: 'Design the graph',
    body: 'Sketch the happy path, then the failure paths. Decide what should alert a human, not just what should run automatically.',
  },
  {
    index: '03',
    title: 'Build and stress-test',
    body: 'Wire it in n8n or Make. Add retries, dedupe, idempotency and a kill switch before calling it finished.',
  },
  {
    index: '04',
    title: 'Hand it over',
    body: 'A written map, a walkthrough and real ownership. You should be able to explain the system without me in the room.',
  },
];

const facts = [
  { label: 'Studio', value: 'Sunny Automates' },
  { label: 'Operator', value: 'Sahil · India' },
  { label: 'Focus', value: 'Ops, inbox, leads' },
  { label: 'Stack', value: 'n8n · Make · OpenAI' },
  { label: 'Status', value: 'Open for new builds', status: true },
];
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-wrap">
      <div class="hero-meta">
        <p class="eyebrow"><span class="num">SA / 001</span> Independent automation builder</p>
        <p class="hero-location">India · IST · working remotely</p>
      </div>

      <h1 class="display hero-title" id="hero-title">
        <span>Find the break.</span>
        <span>Wire the fix.</span>
        <span>Let it <em class="serif">run.</em></span>
      </h1>

      <div class="hero-bottom">
        <div class="hero-copy">
          <p class="lede">
            I’m Sahil — a student who builds n8n and Make systems for lean teams.
            I start with the process that’s broken, not the tool that’s trending.
          </p>
          <div class="hero-actions">
            <a class="btn" href={gmailLink} target="_blank" rel="noopener">
              Book a discovery call <span class="arrow">↗</span>
            </a>
            <a class="btn btn--ghost" href="#work">
              See the systems <span class="arrow">↓</span>
            </a>
          </div>
        </div>

        <ul class="hero-facts" aria-label="At a glance">
          {facts.map((fact) => (
            <li>
              <span>{fact.label}</span>
              <strong class:list={{ status: fact.status }}>
                {fact.status && <i aria-hidden="true"></i>}
                {fact.value}
              </strong>
            </li>
          ))}
        </ul>
      </div>

      <div class="hero-graph reveal">
        <HeroGraph />
      </div>
    </div>
  </section>

  <section class="stack-strip" aria-label="Tools I work with">
    <div class="wrap stack-head">
      <span>The stack</span>
      <span>Tools change. The process doesn’t.</span>
    </div>
    <div class="marquee">
      <div class="marquee__track">
        <div class="marquee__group">
          {stack.map((tool) => (
            <span class="stack-item">{tool}</span>
          ))}
        </div>
        <div class="marquee__group" aria-hidden="true">
          {stack.map((tool) => (
            <span class="stack-item">{tool}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section work" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow"><span class="num">01</span> Selected systems</p>
          <h2 class="section-title" id="work-title">
            Systems, not <em class="serif">demos.</em>
          </h2>
        </div>
        <p class="section-note">
          Five live n8n workflows, mapped end-to-end from the actual graphs. Pulled straight from my
          n8n instance — no client logos, no invented numbers.
        </p>
      </div>

      <div class="work-list">
        {projects.map((project, i) => (
          <WorkRow project={project} order={i} />
        ))}
      </div>

      <div class="work-foot">
        <p>Every diagram is the actual architecture — trigger, guardrail, fallback.</p>
        <a class="text-link" href={gmailLink} target="_blank" rel="noopener">
          Ask me to walk you through one <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section approach" id="approach" aria-labelledby="approach-title">
    <div class="wrap approach-wrap">
      <div class="section-head section-head--light">
        <div>
          <p class="eyebrow"><span class="num">02</span> How I work</p>
          <h2 class="section-title" id="approach-title">
            The tool is the <em class="serif">last</em> decision.
          </h2>
        </div>
        <p class="section-note">
          Most automation fails because it starts with a node, not a process. I map the loop first —
          who touches it, where it stalls, what happens on a bad day — then build the smallest
          reliable system that removes the stall.
        </p>
      </div>

      <ol class="process">
        {process.map((step) => (
          <li class="process-step">
            <span class="process-dot" aria-hidden="true"></span>
            <span class="process-index">{step.index}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>

      <div class="principles">
        <span>No black boxes.</span>
        <span>No silent failures.</span>
        <span>No “it works on my machine”.</span>
      </div>
    </div>
  </section>

  <section class="section about" id="about" aria-labelledby="about-title">
    <div class="wrap about-grid">
      <div class="about-main">
        <p class="eyebrow"><span class="num">03</span> About</p>
        <h2 class="about-quote" id="about-title">
          “I notice the loop everyone else has learned to <em class="serif">live with</em>.”
        </h2>

        <div class="about-copy">
          <p>
            I’m Sahil — a student building automation under the name Sunny Automates. I got here
            through curiosity: a spreadsheet that kept breaking, an inbox that kept winning, and the
            stubborn feeling that the work could be wired differently.
          </p>
          <p>
            ADHD means I notice friction other people have normalised. It also means I test the
            boring edge cases until the system holds. I would rather spend an extra hour on failure
            handling than ship a demo that looks good and dies quietly.
          </p>
          <p>
            I don’t have a wall of client logos yet. What I do have is a set of working systems,
            diagrams that explain themselves, and the habit of finding the break before I build the
            fix. If you want proof, I’ll walk you through any workflow on this site.
          </p>
        </div>

        <div class="about-links">
          <a class="text-link" href={site.linkedin} target="_blank" rel="noopener">
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={site.github} target="_blank" rel="noopener">
            GitHub <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={`mailto:${site.email}`}>
            Email <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <aside class="operator-card reveal" aria-label="Operator card">
        <div class="operator-top">
          <span class="operator-label">Operator card</span>
          <span class="operator-code">SA—001</span>
        </div>

        <div class="operator-head">
          <span class="monogram serif">SS</span>
          <div>
            <p class="operator-name">Sahil Singh</p>
            <p class="operator-role">Automation builder</p>
          </div>
        </div>

        <dl class="operator-data">
          <div><dt>Base</dt><dd>India · IST</dd></div>
          <div><dt>Current</dt><dd>Student</dd></div>
          <div><dt>Method</dt><dd>Find break → build → test</dd></div>
          <div><dt>Focus</dt><dd>Inbox, leads, follow-up</dd></div>
          <div><dt>Stack</dt><dd>n8n · Make · OpenAI</dd></div>
          <div>
            <dt>Status</dt>
            <dd class="operator-status"><i aria-hidden="true"></i>Open for new builds</dd>
          </div>
        </dl>

        <p class="operator-foot">
          Currently exploring: OpenCode · AI agents with approval steps · error-first workflow design
        </p>
      </aside>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <div class="wrap contact-grid">
      <div class="contact-main">
        <p class="eyebrow"><span class="num">04</span> Start a build</p>
        <h2 class="contact-title" id="contact-title">
          Send me the <em class="serif">messiest</em> part of your week.
        </h2>
        <p class="contact-copy">
          Tell me what keeps breaking, what tools you use, and what happens when it fails. I’ll
          reply with an honest read on whether automation is the fix — or something simpler.
        </p>

        <div class="contact-actions">
          <a class="btn contact-btn" href={gmailLink} target="_blank" rel="noopener">
            Book a discovery call <span class="arrow">↗</span>
          </a>
          <button
            class="copy-btn"
            type="button"
            data-copy-email
            data-email={site.email}
            aria-label={`Copy email address ${site.email}`}
          >
            Copy email
          </button>
        </div>

        <p class="contact-alt">
          Prefer your mail app? <a href={mailtoLink}>Open a draft <span aria-hidden="true">↗</span></a>
        </p>
      </div>

      <aside class="brief">
        <p class="brief-label">A useful first email includes</p>
        <ol>
          <li><span>01</span>The process that keeps breaking</li>
          <li><span>02</span>The tools involved</li>
          <li><span>03</span>How often it happens</li>
          <li><span>04</span>What happens when it fails</li>
        </ol>
        <div class="brief-foot">
          <span>Direct email</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  /* Hero */

  .hero {
    position: relative;
    padding-block: clamp(44px, 5.8vw, 76px) clamp(56px, 7vw, 92px);
    overflow: clip;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(22, 21, 15, 0.2) 1px, transparent 1.2px);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 75% 62% at 72% 8%, #000 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 75% 62% at 72% 8%, #000 0%, transparent 70%);
    opacity: 0.55;
    pointer-events: none;
  }

  .hero-wrap {
    position: relative;
    z-index: 1;
  }

  .hero-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    margin-bottom: clamp(38px, 6vw, 76px);
  }

  .hero-location {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    text-align: right;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    max-width: 13ch;
  }

  .hero-title em {
    color: var(--signal-ink);
    padding-right: 0.04em;
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.62fr);
    gap: clamp(36px, 7vw, 110px);
    align-items: end;
    margin-top: clamp(36px, 4.8vw, 60px);
  }

  .hero-copy .lede {
    max-width: 47ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .hero-facts {
    border-bottom: 1px solid var(--line);
  }

  .hero-facts li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
  }

  .hero-facts span {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .hero-facts strong {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: 0;
    text-align: right;
  }

  .hero-facts strong.status i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--signal);
    flex: none;
  }

  .hero-graph {
    margin-top: clamp(48px, 6.5vw, 84px);
  }

  /* Stack strip */

  .stack-strip {
    border-block: 1px solid var(--line);
    background: var(--paper-deep);
    padding-block: 16px 20px;
  }

  .stack-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .stack-head span:last-child {
    color: var(--ink-3);
  }

  .marquee__group {
    display: flex;
    flex: none;
  }

  .stack-item {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding-inline: 24px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .stack-item::after {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--signal);
    flex: none;
  }

  /* Section heads */

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.62fr);
    gap: clamp(30px, 6vw, 100px);
    align-items: end;
    margin-bottom: clamp(44px, 5.5vw, 68px);
  }

  .section-note {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 40ch;
    border-left: 1px solid var(--line-strong);
    padding-left: 20px;
  }

  .section-head .section-title {
    margin-top: 22px;
  }

  .work-list {
    border-bottom: 1px solid var(--line);
  }

  .work-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 14px 28px;
    margin-top: 26px;
    font-size: 13.5px;
    color: var(--ink-2);
  }

  /* Approach */

  .approach {
    position: relative;
    background: var(--ink);
    color: var(--paper-on-ink);
    border-top-color: var(--ink);
    overflow: clip;
  }

  .approach::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(239, 233, 220, 0.15) 1px, transparent 1.2px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse 60% 65% at 30% 20%, #000, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 65% at 30% 20%, #000, transparent 75%);
    opacity: 0.45;
    pointer-events: none;
  }

  .approach-wrap {
    position: relative;
    z-index: 1;
  }

  .section-head--light .eyebrow {
    color: rgba(239, 233, 220, 0.76);
  }

  .section-head--light .eyebrow .num {
    color: rgba(239, 233, 220, 0.6);
  }

  .section-head--light .section-title {
    color: var(--paper-on-ink);
  }

  .section-head--light .serif {
    color: var(--signal);
  }

  .section-head--light .section-note {
    color: rgba(239, 233, 220, 0.78);
    border-color: rgba(239, 233, 220, 0.3);
  }

  .process {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px dashed rgba(239, 233, 220, 0.22);
  }

  .process-step {
    position: relative;
    padding: 30px 30px 0 0;
    border-right: 1px solid rgba(239, 233, 220, 0.12);
  }

  .process-step:last-child {
    border-right: 0;
    padding-right: 0;
  }

  .process-step + .process-step {
    padding-left: 30px;
  }

  .process-dot {
    position: absolute;
    top: -5px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ink);
    border: 1px solid var(--signal);
  }

  .process-step + .process-step .process-dot {
    left: 30px;
  }

  .process-index {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--signal);
    margin-bottom: 18px;
  }

  .process-step h3 {
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin-bottom: 12px;
  }

  .process-step p {
    font-size: 14.5px;
    line-height: 1.62;
    color: rgba(239, 233, 220, 0.76);
    max-width: 32ch;
  }

  .principles {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 52px;
    margin-top: clamp(52px, 6vw, 76px);
    padding-top: 24px;
    border-top: 1px solid rgba(239, 233, 220, 0.2);
  }

  .principles span {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--paper-on-ink);
  }

  .principles span::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--signal);
    flex: none;
  }

  /* About */

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.6fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: start;
  }

  .about-quote {
    margin: 26px 0 34px;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 600;
    max-width: 21ch;
  }

  .about-quote em {
    color: var(--signal-ink);
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 58ch;
  }

  .about-copy p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .about-copy p:first-child {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink);
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    margin-top: 34px;
  }

  .operator-card {
    position: sticky;
    top: calc(var(--header-h) + 26px);
    border: 1px solid var(--line-strong);
    background: var(--paper-raised);
    padding: 18px 22px 22px;
    box-shadow: 6px 6px 0 rgba(22, 21, 15, 0.06);
  }

  .operator-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .operator-head {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-block: 20px;
    border-bottom: 1px solid var(--line);
  }

  .monogram {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border: 1px solid var(--ink);
    font-size: 42px;
    line-height: 1;
    color: var(--ink);
    background:
      radial-gradient(circle at 78% 22%, var(--signal) 0 4px, transparent 4.5px),
      repeating-linear-gradient(0deg, transparent 0 11px, rgba(22, 21, 15, 0.07) 11px 12px),
      repeating-linear-gradient(90deg, transparent 0 11px, rgba(22, 21, 15, 0.07) 11px 12px);
    flex: none;
  }

  .operator-name {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .operator-role {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-top: 5px;
  }

  .operator-data {
    padding-block: 4px;
  }

  .operator-data div {
    display: grid;
    grid-template-columns: 82px minmax(0, 1fr);
    gap: 12px;
    padding-block: 11px;
    border-bottom: 1px solid var(--line);
  }

  .operator-data div:last-child {
    border-bottom: 0;
  }

  .operator-data dt {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-top: 2px;
  }

  .operator-data dd {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.35;
    color: var(--ink);
  }

  .operator-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--signal-ink) !important;
  }

  .operator-status i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--signal);
    animation: blink 2.8s ease-in-out infinite;
  }

  .operator-foot {
    margin-top: 14px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 10.5px;
    line-height: 1.6;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* Contact */

  .contact {
    position: relative;
    background: var(--signal);
    color: var(--ink);
    padding-block: clamp(84px, 9.5vw, 132px);
    overflow: clip;
  }

  .contact::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(22, 21, 15, 0.28) 1px, transparent 1.2px);
    background-size: 25px 25px;
    mask-image: radial-gradient(ellipse 65% 70% at 85% 90%, #000, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 65% 70% at 85% 90%, #000, transparent 70%);
    opacity: 0.35;
    pointer-events: none;
  }

  .contact-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.7fr);
    gap: clamp(40px, 7vw, 110px);
    align-items: end;
  }

  .contact .eyebrow {
    color: rgba(22, 21, 15, 0.82);
  }

  .contact .eyebrow .num {
    color: rgba(22, 21, 15, 0.68);
  }

  .contact-title {
    margin-top: 24px;
